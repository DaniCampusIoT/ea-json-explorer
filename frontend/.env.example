# ── Microsoft Entra ID (Azure AD) ──────────────────────────────────
# Copia este archivo como .env.local y rellena tus valores.
# Nunca subas .env.local al repositorio.

# ID de la aplicación registrada en Azure Portal
VITE_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ID del tenant de Quandum Aerospaces en Azure AD
# Encuéntralo en Azure Portal → Microsoft Entra ID → Overview → Tenant ID
VITE_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URI de redirección (debe coincidir con la registrada en Azure Portal)
# En desarrollo: http://localhost:5173
# En producción: https://tu-dominio.com
VITE_REDIRECT_URI=http://localhost:5173
