# ── IA ──────────────────────────────────────────────────────
AI_PROVIDER=openai          # openai | groq
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o         # gpt-4o | gpt-5.6-terra | gpt-5.6-sol ...
# GROQ_API_KEY=gsk-...
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Auth Google ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173
JWT_SECRET=cambia-este-secreto-en-produccion

# ── Control de acceso ────────────────────────────────────────
# Emails separados por coma. Si se deja vacío, cualquier cuenta Google puede entrar.
# Ejemplo: ALLOWED_EMAILS=tu@gmail.com,colega@empresa.com
ALLOWED_EMAILS=
